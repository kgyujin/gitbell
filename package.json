  ],
  "homepage": "https://github.com/kgyujin/gitbell#readme",
  "bugs": "https://github.com/kgyujin/gitbell/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kgyujin/gitbell.git"
  },
  "license": "MIT",
  "author": "kgyujin",
  "bin": {
    "gitbell": "bin/gitbell.js"
  },
  "files": [
    "bin",
    "Sources",
    "Tests",
    "Resources",
    "windows/package.json",
    "windows/package-lock.json",
    "windows/src",
    "windows/assets",
    "scripts",
    "Package.swift",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "os": [
